    <description>A lightweight, high-performance, and secure library that brings Sieve-like filtering, sorting, and pagination capabilities to raw SQL and ADO.NET/Dapper queries without requiring Entity Framework.</description>
    <tags>sql dapper ado.net sieve filter sort paginate raw-sql parser</tags>
    <repository type="git" url="https://github.com/RawQueryKit/RawQueryKit" />
    <dependencies>
      <group targetFramework=".NETStandard2.0" />
    </dependencies>
  </metadata>
