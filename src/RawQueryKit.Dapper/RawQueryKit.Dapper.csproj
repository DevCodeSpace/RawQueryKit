<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>1.1.0</Version>
    <PackageId>RawQueryKit.Dapper</PackageId>
    <Authors>RawQueryKit Authors</Authors>
    <Description>Dapper extensions for RawQueryKit, providing seamless execution of Sieve-like filtered, sorted, and paginated queries with Dapper.</Description>
    <RepositoryUrl>https://github.com/example/RawQueryKit</RepositoryUrl>
    <Tags>dapper sql rawquerykit sieve pagination sorting filtering</Tags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <ProjectReference Include="..\RawQueryKit\RawQueryKit.csproj" />
  </ItemGroup>

</Project>
