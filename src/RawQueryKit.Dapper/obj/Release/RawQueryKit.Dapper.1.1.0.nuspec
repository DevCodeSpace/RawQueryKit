    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="RawQueryKit" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Dapper" version="2.1.35" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
