# -----------------------------------------------------------------------------
# IDEs & Code Editors (VS Code, Visual Studio, JetBrains, Cursor)
# Prevents execution of malicious tasks, workspace configs, and user-specific states
# -----------------------------------------------------------------------------
.vscode/
.vscode/*
.idea/
.cursor/
.antigravity/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# -----------------------------------------------------------------------------
# Scripts & Executables (Prevents accidental check-in of malicious/local scripts)
# -----------------------------------------------------------------------------
config.bat
*.bat
*.cmd
*.ps1
*.sh
*.exe
*.dll
*.msi
*.scr
*.vbs
*.hta

# -----------------------------------------------------------------------------
# Sensitive Files, Credentials & Environment Configurations
# -----------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
secrets.json
appsettings*.local.json
appsettings.Development.json

# -----------------------------------------------------------------------------
# .NET / C# Build Artifacts & Output
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
TestResults/
*.userprefs
*.pidb
*.booproj
*.svclog
packages/
*.nuget.props
*.nuget.targets

# -----------------------------------------------------------------------------
# Node & Dependencies
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
